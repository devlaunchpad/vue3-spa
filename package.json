{
  "name": "vue3-spa",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3333",
    "build": "vue-tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "preview:https": "serve dist",
    "test": "vitest",
    "test:e2e": "cypress open",
    "typecheck": "vue-tsc --noEmit",
    "tz": "taze minor -I",
    "ri": "rimraf pnpm-lock.yaml && rimraf package.lock.json && rimraf node_modules && pnpm i",
    "sizecheck": "npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@vueuse/core": "^11.3.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.16",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@iconify-json/carbon": "^1.2.9",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@shikijs/markdown-it": "^1.29.2",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue-macros/volar": "^0.27.4",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^13.17.0",
    "cypress-vite": "^1.6.0",
    "eslint": "^9.28.0",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-format": "^0.1.3",
    "https-localhost": "^4.7.1",
    "jsdom": "^24.1.3",
    "less": "^4.3.0",
    "lint-staged": "^15.5.2",
    "markdown-it-link-attributes": "^4.0.1",
    "pnpm": "^9.15.9",
    "rimraf": "^6.0.1",
    "rollup": "^4.43.0",
    "simple-git-hooks": "^2.13.0",
    "taze": "^19.1.0",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "unplugin-vue-macros": "^2.14.5",
    "unplugin-vue-markdown": "^0.26.3",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^5.4.19",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-inspect": "^0.8.9",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plugin-webfont-dl": "^3.10.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
